{
  "manifest_version": 3,
  "name": "Quiet Tab",
  "version": "1.2.0",
  "description": "A minimal, customizable New Tab page.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "favicon"
  ],
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "minimum_chrome_version": "111"
}
